# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# This example is the all-Google configuration: Cloud Run, Cloud SQL, Cloud
# Storage, Secret Manager, Artifact Registry and Gmail SMTP. No third-party
# accounts are needed.

project_id     = "my-gcp-project-id"
project_number = "123456789012"   # gcloud projects describe my-gcp-project-id --format='value(projectNumber)'

# europe-west1 (Belgium) keeps EU data in the EU and is among the cheapest regions.
# Firebase Hosting can only rewrite to Cloud Run in a subset of regions, and
# europe-west1 is one of them — changing this means rechecking that.
region      = "europe-west1"
environment = "prod"

###############################################################################
# Public URL
###############################################################################
# The custom domain is served by Firebase Hosting, which proxies to Cloud Run
# (see firebase.json). Firebase issues and renews the TLS certificate free of
# charge; a global load balancer would do the same job for ~EUR 18/month.
#
# This value is what the app puts in emails and password-reset links, so it
# must be the address people actually visit — not the run.app URL.
app_url = "https://crewly360.com"

###############################################################################
# Database — Cloud SQL (Google-native)
###############################################################################
# Worth knowing: there is NO always-free tier for Cloud SQL. It is covered by
# the $300 new-customer credit and the 30-day Cloud SQL trial instance. After
# that, db-f1-micro runs about EUR 8-10/month and does not scale to zero, so
# it is charged whether or not anyone uses the app.
#
# Everything else in this stack does bill to zero when idle, so this is
# effectively the whole running cost.

use_cloud_sql = true
database_tier = "db-f1-micro"   # smallest available; the cost floor

# REGIONAL failover + SSD + point-in-time recovery. Roughly doubles the
# database cost — leave off until an outage would cost you more than that.
database_high_availability = false

database_deletion_protection = true

###############################################################################
# Email — Gmail SMTP (Google-native)
###############################################################################
# Google Cloud has no transactional email service of its own and blocks
# outbound port 25, so Gmail SMTP is the all-Google option. Free, and around
# 500 messages a day, which is ample early on.
#
# Setup:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces can be left in or removed)
#
# Gmail rewrites the From header to the authenticated account, so
# mail_from_address must match mail_username.

mail_host         = "smtp.gmail.com"
mail_port         = 587
mail_scheme       = "smtp"
mail_username     = "you@gmail.com"
mail_password     = "abcd efgh ijkl mnop"   # App Password, NOT your Google password
mail_from_address = "you@gmail.com"
mail_contact_to   = "you@gmail.com"         # where landing-page enquiries go

# For a look around without sending real email, set mail_mailer = "log" and
# leave a placeholder password. Signup will not complete in that mode, because
# the verification email never arrives.
# mail_mailer = "log"

###############################################################################
# Scaling and cost controls
###############################################################################

# min_instances = 0 is what makes Cloud Run bill nothing when nobody is using
# it. Set to 1 only if a ~2 second cold start is unacceptable (~EUR 13/month).
min_instances = 0

# A hard ceiling on spend: even under a traffic spike you cannot be billed for
# more than this many instances at once.
max_instances = 10
concurrency   = 80

###############################################################################
# Behaviour
###############################################################################

# Leave false. deploy.sh runs migrations once as a Cloud Run job before
# shifting traffic; running them per-container makes instances race.
run_migrations_on_boot = false

allow_public_access = true

###############################################################################
# Not used in the all-Google setup
###############################################################################
# Only relevant with use_cloud_sql = false, which swaps Cloud SQL for an
# external serverless Postgres (e.g. Neon) to get a genuine EUR 0 idle bill.
# database_url = "postgres://user:password@host/db?sslmode=require"

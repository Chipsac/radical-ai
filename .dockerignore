# Keep the build context small and secrets out of the image.
.git
.github
node_modules
vendor
public/build
public/hot
public/storage

.env
.env.*
!.env.example

storage/app/payslips
storage/app/public
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*

database/*.sqlite
database/*.sqlite-journal

infra/.terraform
infra/*.tfstate
infra/*.tfstate.*
infra/.terraform.lock.hcl

tests
phpunit.xml
.phpunit.result.cache

*.md
!README.md
